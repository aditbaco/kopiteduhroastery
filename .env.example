NEXT_PUBLIC_APP_URL=http://localhost:3000
BASEPATH=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL="mysql://user:password@127.0.0.1:3306/teduhcoffeeroastery"

# -----------------------------------------------------------------------------
# WhatsApp checkout
# -----------------------------------------------------------------------------
# Destination for the pre-filled order message. International format, no +/dashes.
NEXT_PUBLIC_WHATSAPP_NUMBER=6285394376023

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
# Single shared password for the admin dashboard. There are no per-user accounts,
# so anyone with this password can edit the catalog — treat it accordingly.
ADMIN_PASSWORD=

# Signing key for the admin session cookie. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
